# Copy this file to "keystore.properties" (same directory as this file) and
# fill in your real release-signing details. NEVER commit the real file or
# your actual .jks/.keystore to version control (it is already covered by
# .gitignore).
#
# storeFile can be a relative or absolute path to your keystore.
storeFile=../release-keystore.jks
storePassword=CHANGE_ME
keyAlias=elitecaller
keyPassword=CHANGE_ME
